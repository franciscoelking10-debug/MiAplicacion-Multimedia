<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9"
    android:orientation="vertical"
    tools:context=".WelcomeActivity">

    <!-- Header institucional -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#006847"
        android:padding="20dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¡Bienvenida al Sistema!"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pantalla de confirmación de registro de usuario"
                android:textColor="#C8E6C9"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <ImageView
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_gravity="center_horizontal"
                        android:src="@drawable/ic_avatar_student"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:id="@+id/tvWelcomeGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:text="¡Hola, Juan Pérez!"
                        android:textColor="#006847"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:text="Usuario registrado y validado con éxito."
                        android:textColor="#718096"
                        android:textSize="14sp"
                        android:layout_marginBottom="24dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E2E8F0"
                        android:layout_marginBottom="16dp" />

                    <!-- Datos Resumen -->
                    <TextView
                        android:id="@+id/tvWelcomeRut"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RUT: 12.345.678-9"
                        android:textColor="#2D3748"
                        android:textSize="15sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvWelcomeEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Correo: usuario@santotomas.cl"
                        android:textColor="#2D3748"
                        android:textSize="15sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvWelcomePhone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Teléfono: +56912345678"
                        android:textColor="#2D3748"
                        android:textSize="15sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvWelcomeAddress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dirección: Av. Principal 123"
                        android:textColor="#2D3748"
                        android:textSize="15sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvWelcomeAge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Edad: 22 años"
                        android:textColor="#2D3748"
                        android:textSize="15sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvWelcomeGender"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Género: Masculino"
                        android:textColor="#2D3748"
                        android:textSize="15sp"
                        android:layout_marginBottom="24dp" />

                    <Button
                        android:id="@+id/btnBackFromWelcome"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="Volver al Menú Principal"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#006847"
                        android:textStyle="bold" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
