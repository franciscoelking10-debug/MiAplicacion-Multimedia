<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9"
    android:fillViewport="true"
    tools:context=".RegisterActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Barra superior -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#006847"
            android:padding="16dp"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnBackRegister"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_launcher_foreground"
                android:tint="#FFFFFF"
                android:contentDescription="Regresar" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Formulario de Registro"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Desafío Práctico 1 • Validación y ProgressBar"
                    android:textColor="#C8E6C9"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tarjeta del Formulario -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Por favor ingrese sus datos"
                    android:textColor="#1A202C"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Todos los campos marcados son obligatorios."
                    android:textColor="#718096"
                    android:textSize="13sp"
                    android:layout_marginBottom="16dp" />

                <!-- RUT -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RUT *"
                    android:textColor="#2D3748"
                    android:textStyle="bold"
                    android:textSize="13sp" />
                <EditText
                    android:id="@+id/etRut"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Ej: 12.345.678-9"
                    android:inputType="text"
                    android:padding="10dp"
                    android:background="@drawable/bg_table_border"
                    android:layout_marginBottom="12dp" />

                <!-- Nombre -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nombre *"
                    android:textColor="#2D3748"
                    android:textStyle="bold"
                    android:textSize="13sp" />
                <EditText
                    android:id="@+id/etNombre"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Ej: Juan"
                    android:inputType="textPersonName"
                    android:padding="10dp"
                    android:background="@drawable/bg_table_border"
                    android:layout_marginBottom="12dp" />

                <!-- Apellido Paterno -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Apellido Paterno *"
                    android:textColor="#2D3748"
                    android:textStyle="bold"
                    android:textSize="13sp" />
                <EditText
                    android:id="@+id/etApellidoPaterno"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Ej: Pérez"
                    android:inputType="textPersonName"
                    android:padding="10dp"
                    android:background="@drawable/bg_table_border"
                    android:layout_marginBottom="12dp" />

                <!-- Apellido Materno -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Apellido Materno *"
                    android:textColor="#2D3748"
                    android:textStyle="bold"
                    android:textSize="13sp" />
                <EditText
                    android:id="@+id/etApellidoMaterno"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Ej: González"
                    android:inputType="textPersonName"
                    android:padding="10dp"
                    android:background="@drawable/bg_table_border"
                    android:layout_marginBottom="12dp" />

                <!-- Edad -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Edad *"
                    android:textColor="#2D3748"
                    android:textStyle="bold"
                    android:textSize="13sp" />
                <EditText
                    android:id="@+id/etEdad"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Ej: 22"
                    android:inputType="number"
                    android:padding="10dp"
                    android:background="@drawable/bg_table_border"
                    android:layout_marginBottom="12dp" />

                <!-- Género (RadioGroup) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Género *"
                    android:textColor="#2D3748"
                    android:textStyle="bold"
                    android:textSize="13sp" />
                <RadioGroup
                    android:id="@+id/rgGenero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <RadioButton
                        android:id="@+id/rbMasculino"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Masculino"
                        android:checked="true" />

                    <RadioButton
                        android:id="@+id/rbFemenino"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Femenino" />

                    <RadioButton
                        android:id="@+id/rbOtro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Otro" />
                </RadioGroup>

                <!-- Teléfono -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Teléfono *"
                    android:textColor="#2D3748"
                    android:textStyle="bold"
                    android:textSize="13sp" />
                <EditText
                    android:id="@+id/etTelefono"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Ej: +56912345678"
                    android:inputType="phone"
                    android:padding="10dp"
                    android:background="@drawable/bg_table_border"
                    android:layout_marginBottom="12dp" />

                <!-- Dirección -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dirección *"
                    android:textColor="#2D3748"
                    android:textStyle="bold"
                    android:textSize="13sp" />
                <EditText
                    android:id="@+id/etDireccion"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Ej: Av. Libertador Bernardo O'Higgins 123"
                    android:inputType="textPostalAddress"
                    android:padding="10dp"
                    android:background="@drawable/bg_table_border"
                    android:layout_marginBottom="12dp" />

                <!-- Correo Electrónico -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Correo Electrónico *"
                    android:textColor="#2D3748"
                    android:textStyle="bold"
                    android:textSize="13sp" />
                <EditText
                    android:id="@+id/etCorreo"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Ej: estudiante@santotomas.cl"
                    android:inputType="textEmailAddress"
                    android:padding="10dp"
                    android:background="@drawable/bg_table_border"
                    android:layout_marginBottom="20dp" />

                <!-- ProgressBar con android:visibility="gone" requerido en la pauta -->
                <ProgressBar
                    android:id="@+id/progressBarRegister"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:visibility="gone"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tvValidatingStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="Validando datos y procesando registro..."
                    android:textColor="#006847"
                    android:textStyle="bold"
                    android:visibility="gone"
                    android:layout_marginBottom="12dp" />

                <!-- Botón VALIDAR -->
                <Button
                    android:id="@+id/btnValidar"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="VALIDAR Y REGISTRAR"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#006847"
                    android:textStyle="bold"
                    android:textSize="16sp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
