<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Declaración de hardware opcional para cámara (Compatibilidad Android 30 / API 30) -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Queries para visibilidad de paquetes en Android 11+ (API 30) -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <!-- Permisos de red y almacenamiento multimedia (Actividad 2.4 - API 30) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MiAplicacion">

        <!-- Actividad Principal (Menú Hub) -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Actividades de la Actividad 2.1 (Evaluación Actual) -->
        <activity
            android:name=".Inicio"
            android:exported="true"
            android:label="Actividad 2.1 - Inicio (Cámara)">
            <!-- Permite ser lanzada directamente si se desea -->
        </activity>

        <activity
            android:name=".AResultado"
            android:exported="false"
            android:label="Actividad 2.1 - AResultado" />

        <!-- Actividades anteriores (Unidad 1) -->
        <activity
            android:name=".MainActivity2"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".WelcomeActivity"
            android:exported="false" />
        <activity
            android:name=".CourseListActivity"
            android:exported="false" />
    
        <!-- Actividad 2.2: Threads y Sensores (IEI-093) -->
        <activity
            android:name=".ThreadsSensorsActivity"
            android:exported="true"
            android:label="Actividad 2.2 - Threads y Sensores" />

        <service
            android:name=".SensorBackgroundService"
            android:exported="false" />

        <!-- Actividad 2.4: Elementos Multimedia (IEI-093) -->
        <activity
            android:name=".MultimediaActivity"
            android:exported="true"
            android:label="Actividad 2.4 - Elementos Multimedia" />

    </application>

</manifest>
