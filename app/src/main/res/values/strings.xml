    <string name="btn_request_permission">Verificar / Solicitar Permisos</string>
    <string name="toast_permission_already_granted">Los permisos requeridos ya fueron concedidos previamente.</string>
    <string name="toast_permission_granted">Permisos concedidos exitosamente por el usuario.</string>
    <string name="toast_permission_denied">Permiso denegado. Algunas características pueden requerir confirmación.</string>

