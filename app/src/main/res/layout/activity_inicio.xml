<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9"
    tools:context=".Inicio">

    <!-- 1. Encabezado CAMARA (Fiel al diseño de la pauta) -->
    <LinearLayout
        android:id="@+id/headerCamara"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#111827"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_camara"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/headerCamara"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal">

            <!-- Botón HACER FOTO (Exactamente id btnFoto como en la pauta) -->
            <Button
                android:id="@+id/btnFoto"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:backgroundTint="#6200EE"
                android:text="@string/btn_hacer_foto"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:icon="@drawable/ic_camera"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:cornerRadius="8dp"
                android:elevation="4dp" />

            <!-- Contenedor de la Imagen (ImageView) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#000000">

                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/fotografo_ejemplo"
                    android:contentDescription="Fotografía del atardecer" />
            </androidx.cardview.widget.CardView>

            <!-- Card de Captura del Nombre de la Foto -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvLabelNombreFoto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_nombre_foto"
                        android:textColor="#374151"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/ETNombreFoto"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_table_cell"
                        android:hint="@string/hint_nombre_foto"
                        android:inputType="textCapSentences"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="#111827"
                        android:textSize="15sp" />

                    <!-- Botón ACEPTAR (Exactamente id BTAceptar como en la pauta) -->
                    <Button
                        android:id="@+id/BTAceptar"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="16dp"
                        android:backgroundTint="#006847"
                        android:text="@string/btn_aceptar"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:cornerRadius="8dp"
                        android:elevation="3dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Sección Educativa: Ciclo de Vida e Intents Implícitos -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Intents Implícitos del Sistema"
                        android:textColor="#006847"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Demostración de delegación de tareas al SO (Diapositivas 8, 9 y 10):"
                        android:textColor="#6B7280"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnCompartirInicio"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="12dp"
                        android:backgroundTint="#0284C7"
                        android:text="Compartir Mensaje (ACTION_SEND)"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        app:icon="@drawable/ic_share"
                        app:cornerRadius="8dp" />

                    <Button
                        android:id="@+id/btnWebInicio"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="#059669"
                        android:text="Documentación Oficial (ACTION_VIEW)"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        app:icon="@drawable/ic_web"
                        app:cornerRadius="8dp" />

                    <!-- Estado del Ciclo de Vida -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="#F3F4F6"
                        android:padding="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_check_circle"
                            android:contentDescription="Check" />

                        <TextView
                            android:id="@+id/tvLifecycleStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Ciclo de vida: onResume()"
                            android:textColor="#1F2937"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnVolverMenu"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="12dp"
                        android:backgroundTint="#6B7280"
                        android:text="@string/btn_volver_menu_ppal"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        app:icon="@drawable/ic_arrow_back"
                        app:cornerRadius="8dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>