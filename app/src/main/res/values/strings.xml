    <string name="section_permissions_title">1. Permisos en Tiempo de Ejecución</string>
    <string name="section_permissions_desc">Evaluación y solicitud dinámica mediante ActivityCompat.requestPermissions (READ_EXTERNAL_STORAGE e INTERNET) acorde a Scoped Storage en Android 11+.</string>
    <string name="label_permission_status">Estado actual:</string>
    <string name="permission_status_checking">Verificando permisos...</string>
    <string name="permission_status_granted">Concedido (Acceso a medios y almacenamiento habilitado)</string>
