<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollViewMain2"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9"
    android:fillViewport="true"
    tools:context=".MainActivity2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Barra Superior Institucional -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#006847"
            android:padding="16dp"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnBackMain2"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_launcher_foreground"
                android:tint="#FFFFFF"
                android:contentDescription="Regresar" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Actividad 1.4: Widgets y Contenedores"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pauta Oficial • CalendarView, Bars y TableLayout"
                    android:textColor="#C8E6C9"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- SECCIÓN 1: WIDGET CALENDARVIEW -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. Widget: CalendarView"
                    android:textColor="#006847"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSelectedDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fecha seleccionada: Toca un día en el calendario"
                    android:textColor="#4A5568"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp" />

                <!-- CalendarView con los atributos exactos de la pauta -->
                <CalendarView
                    android:id="@+id/calendarView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="30dp"
                    android:layout_marginBottom="30dp"
                    android:layout_marginStart="31dp"
                    android:layout_marginEnd="31dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- SECCIÓN 2: PROGRESSBAR Y RATINGBAR -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. Widgets: ProgressBar y RatingBar"
                    android:textColor="#006847"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Barra de Progreso Horizontal -->
                <TextView
                    android:id="@+id/tvProgressValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Barra de Progreso: 45%"
                    android:textColor="#2D3748"
                    android:textSize="14sp"
                    android:layout_marginTop="12dp" />

                <ProgressBar
                    android:id="@+id/progressBarHorizontal"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:layout_marginTop="6dp"
                    android:max="100"
                    android:progress="45"
                    android:progressTint="#006847" />

                <!-- Botones para interactuar con ProgressBar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <Button
                        android:id="@+id/btnIncrementProgress"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="+15% Progreso"
                        android:backgroundTint="#006847"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnResetProgress"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Reiniciar (0%)"
                        android:backgroundTint="#718096"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Barra de Rating con atributos exactos de la pauta -->
                <TextView
                    android:id="@+id/tvRatingValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RatingBar (Calificación: 4.0 / 5.0):"
                    android:textColor="#2D3748"
                    android:textSize="14sp"
                    android:layout_marginTop="16dp" />

                <RatingBar
                    android:id="@+id/ratingBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:contentDescription="Calificación del producto"
                    android:numStars="5"
                    android:rating="4.0"
                    android:stepSize="0.5" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- SECCIÓN 3: BARRAS DE SEGMENTO (SEEKBAR CONTINUA Y DISCRETA) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3. Widgets: Barras de Segmento (SeekBar)"
                    android:textColor="#006847"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Barra de Segmento Continua -->
                <TextView
                    android:id="@+id/tvSeekBarContinuous"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Barra de segmento continua: 50%"
                    android:textColor="#2D3748"
                    android:textSize="14sp"
                    android:layout_marginTop="12dp" />

                <SeekBar
                    android:id="@+id/seekBarContinuous"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:max="100"
                    android:progress="50"
                    android:thumbTint="#006847"
                    android:progressTint="#006847" />

                <!-- Barra de Segmento Discreta -->
                <TextView
                    android:id="@+id/tvSeekBarDiscrete"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Barra de segmento discreta: Nivel 3 de 5"
                    android:textColor="#2D3748"
                    android:textSize="14sp"
                    android:layout_marginTop="16dp" />

                <SeekBar
                    android:id="@+id/seekBarDiscrete"
                    style="@style/Widget.AppCompat.SeekBar.Discrete"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:max="5"
                    android:progress="3"
                    android:thumbTint="#00A86B"
                    android:progressTint="#00A86B" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- SECCIÓN 4: CONTENEDOR TABLELAYOUT CON TABLEROW E IMAGEVIEW (Pauta 1.4) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#FFFFFF">

            <!-- LinearLayout dentro del código según pauta paso 63 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Encabezado de texto principal dentro del LinearLayout (paso 69) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4. Contenedor: TableLayout y TableRow"
                    android:textColor="#006847"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estructuración de datos en filas y columnas con ImageView:"
                    android:textColor="#718096"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="12dp" />

                <!-- TableLayout según paso 71 de la pauta -->
                <TableLayout
                    android:id="@+id/tableLayoutCustom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stretchColumns="*"
                    android:background="@drawable/bg_table_border"
                    android:padding="4dp">

                    <!-- Fila 1: Nombres de columnas (TableRow) pasos 75-88 -->
                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#E8F5E9"
                        android:padding="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="ID"
                            android:textColor="#000000"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="Nombre"
                            android:textColor="#000000"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="Apellido"
                            android:textColor="#000000"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="Foto"
                            android:textColor="#000000"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </TableRow>

                    <!-- Fila 2: Registro con ImageView (pasos 90-94 de la pauta) -->
                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:padding="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="01"
                            android:textColor="#2D3748"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="Carlos"
                            android:textColor="#2D3748"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="Pérez"
                            android:textColor="#2D3748"
                            android:textSize="14sp" />

                        <!-- ImageView desde carpeta drawable (paso 94) -->
                        <ImageView
                            android:id="@+id/ivAlumno1"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:padding="4dp"
                            android:src="@drawable/ic_avatar_student"
                            android:contentDescription="Avatar de Carlos Pérez" />
                    </TableRow>

                    <!-- Fila 3: Registro adicional (paso 96) -->
                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#F8FAFC"
                        android:gravity="center_vertical"
                        android:padding="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="02"
                            android:textColor="#2D3748"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="María"
                            android:textColor="#2D3748"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="Gómez"
                            android:textColor="#2D3748"
                            android:textSize="14sp" />

                        <ImageView
                            android:id="@+id/ivAlumno2"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:padding="4dp"
                            android:src="@drawable/ic_avatar_student"
                            android:contentDescription="Avatar de María Gómez" />
                    </TableRow>

                    <!-- Fila 4: Registro adicional -->
                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:padding="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="03"
                            android:textColor="#2D3748"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="Andrés"
                            android:textColor="#2D3748"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="Vidal"
                            android:textColor="#2D3748"
                            android:textSize="14sp" />

                        <ImageView
                            android:id="@+id/ivAlumno3"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:padding="4dp"
                            android:src="@drawable/ic_avatar_student"
                            android:contentDescription="Avatar de Andrés Vidal" />
                    </TableRow>
                </TableLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Botones de Navegación Rápida a los Desafíos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnGoRegister"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Ir a Desafío 1: Formulario Registro"
                android:textColor="#FFFFFF"
                android:backgroundTint="#006847"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnGoCourses"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Ir a Desafío 2: Lista Cursos (RecyclerView)"
                android:textColor="#FFFFFF"
                android:backgroundTint="#00A86B" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>